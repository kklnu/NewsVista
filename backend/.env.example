# Copy to backend/.env for local runs (git-ignored). On Render, set these as
# Environment Variables instead. NEVER commit real values.

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4).
# Leave unset locally to use SQLite (backend/local.db).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Long random secret protecting POST /admin/collect (also stored as a GitHub Actions secret).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace-with-long-random-secret

# Google AI Studio API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=replace-with-gemini-key

# Optional tuning
AI_MAX_PER_RUN=6
RETENTION_HOURS=168
WIKI_USER_AGENT=NewsVista/1.0 (CS403 class project; https://github.com/YOUR_USER/YOUR_REPO) httpx/0.28.1
